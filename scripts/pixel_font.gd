static func width(content: String, scale: int = 1) -> float:
    return maxf(0,content.length()*6-1)*scale

static func text(c: CanvasItem, content: String, at: Vector2, scale: int, color: Color) -> void:
    var x := roundf(at.x)
    var y := roundf(at.y)
    for ch in content.to_upper():
        var rows: Array = GLYPHS.get(ch, GLYPHS[" "])
        for row in range(7):
            for col in range(5):
                if (int(rows[row]) & (1 << (4-col))) != 0:
                    c.draw_rect(Rect2(x+col*scale,y+row*scale,scale,scale),color)
        x += 6*scale
